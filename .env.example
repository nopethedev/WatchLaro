[TEMPLATE]
PORT=3000
TMDB_KEY="TMDB_KEY"

# OpenSubtitles.com REST API v1 (the current API; not the old XML-RPC site)
# Create an API consumer at https://www.opensubtitles.com/en/consumers
OPENSUBTITLES_API_KEY=""

# Long-lived login cookies. Set this to a long random string in production.
SESSION_SECRET="replace-with-a-long-random-string"

# "mariadb" (default) or "sqlite"
DB_DIALECT="mariadb"

# only used when DB_DIALECT="mariadb"
DB_NAME="watchlaro"
DB_USER="dbuser"
DB_PASS="password"
DB_HOST="dbhost.example.com"
DB_PORT="3306"

# only used when DB_DIALECT="sqlite"
DB_STORAGE="./database/watchlaro.sqlite"

# set to "false" to silence sequelize query logging
DB_LOGGING="true"
