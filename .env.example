[TEMPLATE]
PORT=3000
TMDB_KEY="TMDB_KEY"

# "mariadb" (default) or "sqlite"
DB_DIALECT="mariadb"

# only used when DB_DIALECT="mariadb"
DB_NAME="watchlaro"
DB_USER="dbuser"
DB_PASS="password"
DB_HOST="dbhost.example.com"
DB_PORT="3306"

# only used when DB_DIALECT="sqlite"
DB_STORAGE="./database/watchlaro.sqlite"

# set to "false" to silence sequelize query logging
DB_LOGGING="true"
