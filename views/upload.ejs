<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="../themes/darkTheme/sidebar.css">
    <link rel="stylesheet" href="../themes/darkTheme/theme.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EveryoneTube | Upload</title>

</head>

<body>
    <%- include('header.ejs') %>
        <div class="content">

            <center>
                <div class="">
                    <h4>Upload a video to EveryoneTube </h4>
                    <div class="mb-3" style="max-width: 30%;">
                        <p>Insert your video (required, max 20mb)</p>
                        <input type="file" name="video" id="video" accept="video/mp4" class="form-control">
                        <p>Insert your thumbnail </p>
                        <input type="file" name="thumbnail" id="thumbnail" class="form-control" accept="image/*">
                        <div id="thumbnailhelp" class="form-text">This is optional. If no thumbnail is provided, we will
                            generate a thumbnail for you. Maxmium 5mb</div>
                        <label for="privacy" class="form-label">Video Privacy</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="privacy" id="Public" checked>
                            <label class="form-check-label" for="Public">
                                Public
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="privacy" id="Private">
                            <label class="form-check-label" for="Private">
                                Private
                            </label>
                        </div>
                        <label for="title">Title</label>
                        <input type="text" name="title" id="title" class="form-control">
                        <label for="desc">Description</label>
                        <textarea name="desc" id="desc" class="form-control" placeholder="pls like and sub"
                            maxlength="500"></textarea>
                        <br>
                        <button id="upload" class="btn btn-primary">Upload</button>
                    </div>

                    <script>
                        document.getElementById("upload").addEventListener("click", async () => {
                            console.log("yo")
                            const videoFile = document.getElementById("video").files[0]
                            const thumbnailFile = document.getElementById("thumbnail").files[0]
                            const title = document.getElementById("title").value
                            const desc = document.getElementById("desc").value

                            const privacy = document.getElementById("Public").checked ? "public" : "private"

                            if (!videoFile || !title || !desc) {
                                iziToast.show({
                                    title: 'Some fields is required.',
                                    message: 'Please put a something in the empty field.',
                                    color: 'red',
                                    icon: "fa-solid fa-circle-exclamation",
                                    position: 'bottomRight'
                                });
                                return;
                            }

                            const newFormData = new FormData;
                            newFormData.append('video', videoFile)
                                .append('title', title)
                                .append('desc', desc)
                                .append('privacy', privacy)
                            if (thumbnailFile) newFormData.append('thumbnail', thumbnailFile);

                            const xhr = new XMLHttpRequest()
                            xhr.open('POST', '/api/video/upload', true)
                        })
                    </script>
                </div>
            </center>



        </div>

</body>

</html>