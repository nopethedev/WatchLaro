<%- include('layoutStart', { title:'Users & access', active:'users' }) %>
<div x-data="adminUsers()"><div class="page-heading"><div><div class="eyebrow">PEOPLE & PERMISSIONS</div><h1>User List</h1><p>Manage the people who call your library home.</p></div><a class="btn primary" href="/admin/users/create">＋ Add user</a></div><p class="notice error" role="alert" x-show="error" x-cloak x-text="error"></p><p class="notice success" role="status" x-show="message" x-cloak x-text="message"></p>
<section class="panel"><div class="toolbar"><input type="search" class="search" placeholder="Search by name or email…" aria-label="Search users" x-model="query" @input.debounce.350ms="filter()"><select x-model="rankFilter" @change="filter()" aria-label="Filter by role"><option value="">All roles</option><option value="member">Member</option><option value="manager">Manager</option><option value="admin">Administrator</option></select></div><div class="loading-bar" x-show="loading"></div><div class="table-wrap"><table><thead><tr><th>User</th><th>Role</th><th>Joined</th><th>Manage</th></tr></thead><tbody><template x-for="user in users" :key="user.uuid"><tr><td><div class="person"><span class="avatar" x-text="user.username.slice(0,1).toUpperCase()"></span><div><strong x-text="user.username"></strong><small x-text="user.email"></small></div></div></td><td><span class="badge" x-text="user.rank === 'user' ? 'member' : user.rank"></span></td><td class="muted" x-text="new Date(user.createdAt).toLocaleDateString()"></td><td><div class="actions"><a class="btn small" :href="'/admin/users/edit/'+user.uuid">Edit user</a><button class="btn small danger" :disabled="!!busy || user.uuid === '<%= uuid %>'" @click="remove(user)">Delete</button></div></td></tr></template></tbody></table></div><div class="empty" x-show="!loading && !users.length" x-cloak><strong>No users found</strong>Try a different name, email or role.</div><div class="pagination"><span x-text="total+' users · Page '+page+' of '+pages"></span><div class="actions"><button class="btn small" :disabled="page<=1 || loading" @click="go(-1)">← Previous</button><button class="btn small" :disabled="page>=pages || loading" @click="go(1)">Next →</button></div></div></section><p class="note">Members browse and watch. Managers maintain media. Administrators manage users and server preferences. Your own account cannot be deleted or demoted here.</p></div>
<%- include('layoutEnd') %>
