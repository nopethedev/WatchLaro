<div class="page-heading"><div><div class="eyebrow">ACCOUNT MANAGEMENT</div><h1><%= editing ? 'Edit user' : 'Add a new user' %></h1><p><%= editing ? 'Update profile details, access and credentials.' : 'Give someone a place in your WatchLaro library.' %></p></div><a class="btn" href="/admin/users">← All users</a></div>
<div x-data='adminUserForm(<%= editing ? JSON.stringify(userUuid) : "null" %>)'><p class="notice error" role="alert" x-show="error" x-cloak x-text="error"></p><section class="panel"><div class="panel-head"><h2>Account details</h2><span class="badge"><%= editing ? 'Existing account' : 'New account' %></span></div><div class="loading-bar" x-show="loading"></div><form class="panel-body" @submit.prevent="save()"><fieldset :disabled="loading || saving"><div class="form-grid"><label class="form-label">Username<input x-model="form.username" required minlength="4" maxlength="16" autocomplete="off"><small>4–16 characters. Must be unique.</small></label><label class="form-label">Email address<input type="email" x-model="form.email" required maxlength="100" autocomplete="off"></label><label class="form-label">Password<input type="password" x-model="form.password" minlength="8" maxlength="128" autocomplete="new-password" <%= editing ? '' : 'required' %>><small><%= editing ? 'Leave blank to keep the existing password.' : 'At least 8 characters.' %></small></label><label class="form-label">Access level<select x-model="form.rank"><option value="member">Member — browse and watch</option><option value="manager">Manager — manage media</option><option value="admin">Administrator — full access</option></select></label><label class="form-label span-2">Profile image URL<input type="url" x-model="form.profilePicture" placeholder="https://…" maxlength="255"><small>Optional HTTP or HTTPS image.</small></label><label class="form-label span-2">Bio<textarea x-model="form.bio" maxlength="255" placeholder="A little about this person…"></textarea></label></div><div class="form-actions"><button class="btn primary" :disabled="saving" x-text="saving ? 'Saving…' : '<%= editing ? 'Save changes' : 'Create account' %>'"></button><a class="btn ghost" href="/admin/users">Cancel</a></div></fieldset></form></section></div>
