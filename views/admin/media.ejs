<%- include('layoutStart', { title:'Media library', active:'media' }) %>
<div x-data="adminMedia()">
<div class="page-heading"><div><div class="eyebrow">YOUR COLLECTION</div><h1>🗃️ Manage Media</h1><p>One place for your movies, episodes and download queue.</p></div><a class="btn primary" href="/admin/media/create">＋ New Download</a></div>
<p class="notice error" role="alert" x-show="error" x-cloak x-text="error"></p><p class="notice success" role="status" x-show="message" x-cloak x-text="message"></p>
<section class="panel">
<div class="toolbar"><input class="search" type="search" aria-label="Search media" placeholder="Search your library…" x-model="query" @input.debounce.350ms="filter()"><select aria-label="Media type" x-model="type" @change="filter()"><option value="">All types</option><option value="movie">Movies</option><option value="tv">Series episodes</option></select><select aria-label="Download status" x-model="status" @change="filter()"><option value="">All statuses</option><option value="done">Ready to watch</option><option value="downloading">Downloading / queued</option><option value="transcoding">Converting</option><option value="paused">Paused</option><option value="failed">Failed</option></select><button class="btn ghost" @click="load()" :disabled="loading">↻ Refresh</button></div>
<div class="loading-bar" x-show="loading"></div>
<div class="empty" x-show="!loading && !files.length" x-cloak><strong>Your library is clear</strong>No media matches these filters. Add a download or try another search.</div>
<div class="p-2">
<template x-for="file in files" :key="file.uuid">
<article class="media-card">
<div class="media-art media-art-grey" x-show="artworkUrl(file)" :style="artBackground(file)" aria-hidden="true"></div>
<div class="media-art media-art-color" x-show="artworkUrl(file)" :style="artBackground(file) + revealStyle(file)" aria-hidden="true"></div>
<div class="media-scrim" x-show="artworkUrl(file)" aria-hidden="true"></div>
<div class="media-fill" x-show="!artworkUrl(file) && percent(file) > 0" :style="'width:' + percent(file) + '%'" aria-hidden="true"></div>
<div class="media-body">
<div class="media-name" x-text="file.name"></div>
<div class="media-meta"><span class="badge" :class="file.status" x-text="label(file)"></span><span x-text="file.quality"></span><span x-text="file.type==='tv'?'Series · S'+file.season+' E'+file.episode:'Movie'"></span><span x-show="file.status==='downloading' && !file.queued" x-text="percent(file).toFixed(1)+'%'"></span></div>
<div class="progress" x-show="file.status==='downloading' && !file.queued"><span :style="'width:'+percent(file)+'%'"></span></div>
</div>
<div class="actions"><a x-show="file.status==='done'" class="btn small" :href="file.type==='tv'?'/tv/'+file.linkedId+'/'+file.season+'/'+file.episode:'/movies/m?q='+file.linkedId">▶ Watch</a><button class="btn small" x-show="file.status==='done' || file.status==='failed'" @click="openEdit(file)">Edit</button><button class="btn small" x-show="file.status==='done'" :disabled="!!busy" @click="action(file,'share')">Share</button><button class="btn small" x-show="file.shareCode" :disabled="!!busy" @click="action(file,'share','DELETE')">Revoke link</button><button class="btn small" x-show="file.status==='downloading' || file.status==='paused'" :disabled="!!busy" @click="action(file,file.status==='paused'?'resume':'pause')" x-text="file.status==='paused'?'Resume':'Pause'"></button><button class="btn small" x-show="file.status==='failed'" :disabled="!!busy" @click="action(file,'retry')">↻ Retry</button><button class="btn small ghost" x-show="file.status==='downloading' && !file.queued" :disabled="!!busy" @click="action(file,'skip')">Force convert</button><button class="btn small danger" :disabled="!!busy || file.status==='transcoding'" @click="action(file,'delete')">Delete</button></div>
</article>
</template>
</div>
<div class="pagination"><span x-text="total+' items · Page '+page+' of '+pages"></span><div class="actions"><button class="btn small" :disabled="page<=1 || loading" @click="go(-1)">← Previous</button><button class="btn small" :disabled="page>=pages || loading" @click="go(1)">Next →</button></div></div>
</section>
<p class="note">Downloads refresh automatically. Queued jobs run one at a time. Completed media is used directly for playback.</p>
<dialog x-ref="editDialog"><h2>Edit media details</h2><form @submit.prevent="saveEdit()"><div class="form-grid"><label class="form-label span-2">Display name<input x-model="edit.name" required maxlength="255"></label><label class="form-label">TMDB ID<input type="number" x-model.number="edit.linkedId" min="1" required></label><label class="form-label">Quality<input x-model="edit.quality" maxlength="30" required></label><label class="form-label span-2">Media type<select x-model="edit.type"><option value="movie">Movie</option><option value="tv">Series episode</option></select></label><label class="form-label" x-show="edit.type==='tv'">Season<input type="number" min="0" x-model.number="edit.season" :required="edit.type==='tv'"></label><label class="form-label" x-show="edit.type==='tv'">Episode<input type="number" min="1" x-model.number="edit.episode" :required="edit.type==='tv'"></label></div><p class="notice error" role="alert" x-show="error" x-text="error"></p><div class="form-actions"><button class="btn primary" :disabled="!!busy">Save changes</button><button class="btn" type="button" @click="$refs.editDialog.close()">Cancel</button></div></form></dialog>
<dialog x-ref="shareDialog"><h2>Share this title</h2><p class="note">Anyone with this link can watch this file. Revoke it from the library to remove access.</p><label class="form-label">Share link<input readonly x-ref="shareValue" @focus="$el.select()"></label><div class="form-actions"><button class="btn primary" @click="copyShare()">Copy link</button><button class="btn" @click="$refs.shareDialog.close()">Close</button></div></dialog>
</div><%- include('layoutEnd') %>
