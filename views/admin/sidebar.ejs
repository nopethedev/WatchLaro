<aside id="admin-sidebar" class="fixed inset-y-0 left-0 z-50 w-56 shrink-0 bg-slate-800 pt-4 transition-all duration-150 md:static md:z-auto md:w-10 md:translate-x-0 md:pt-0 md:hover:w-48 md:focus-within:w-48 motion-reduce:transition-none" :class="adminNavOpen ? 'translate-x-0 visible' : '-translate-x-full invisible md:visible'" aria-label="Admin navigation">
<div class="mb-3 flex items-center justify-between px-3 md:hidden"><strong>Admin navigation</strong><button type="button" class="btn small" @click="adminNavOpen = false; $refs.adminMenuToggle.focus()" aria-label="Close admin navigation">✕</button></div>
<nav class="sticky top-16 px-1 py-1 md:overflow-x-clip md:overflow-y-visible" @click="if ($event.target.closest('a')) adminNavOpen = false">
<% for (const item of [{href:'/admin',label:'Home',icon:'house',key:'overview'},{href:'/admin/media',label:'Media',icon:'film',key:'media'},{href:'/admin/media/create',label:'New download',icon:'download',key:'download'},...(rank === 'admin' ? [{href:'/admin/users',label:'Users',icon:'person',key:'users'}] : []),{href:'/admin/settings',label:'Settings',icon:'cog',key:'settings'}]) { %>
<a href="<%= item.href %>" title="<%= item.label %>" aria-label="<%= item.label %>" class="relative mb-1 flex min-h-11 items-center gap-4 whitespace-nowrap bg-slate-900 px-2 transition-all duration-100 hover:z-10 hover:rounded-md hover:bg-brand focus-visible:rounded-md focus-visible:bg-brand focus-visible:outline-2 focus-visible:outline-blue-400 md:min-h-10 md:hover:ml-2 md:hover:scale-110 motion-reduce:transform-none motion-reduce:transition-none <%= active === item.key ? 'bg-brand' : '' %>" <%- active === item.key ? 'aria-current="page"' : '' %>><i class="fa-solid fa-<%= item.icon %> w-4 shrink-0 text-center" aria-hidden="true"></i><span class="text-lg font-bold"><%= item.label %></span></a>
<% } %>
</nav>
</aside>
