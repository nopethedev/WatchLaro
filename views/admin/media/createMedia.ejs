<%- include('../layoutStart', { title:'New download', active:'download' }) %>
<div x-data='downloadForm(<%= JSON.stringify(defaultQuality) %>)'><div class="page-heading"><div><div class="eyebrow">BUILD YOUR COLLECTION</div><h1>New Download</h1><p>Search for a title, choose a source and let your server do the rest.</p></div><a class="btn" href="/admin/media">← Back to library</a></div>
<p class="notice" role="status" x-show="message" x-cloak x-text="message"></p><div class="notice" x-show="busy" x-cloak><div class="loading-bar"></div>Working… Torrent searches may take a while. Keep this page open while resolving a bulk download.</div>
<fieldset :disabled="busy"><section class="panel"><div class="panel-head"><h2><span class="step">1</span>Find a title</h2><span class="muted">Powered by TMDB</span></div><div class="panel-body"><form @submit.prevent="search()" class="toolbar border-0 p-0"><select aria-label="Media type" x-model="type" @change="reset()"><option value="movie">Movies</option><option value="tv">Series</option></select><input type="search" class="search" x-model="query" placeholder="Search by title…" aria-label="Search titles" required><button class="btn primary">Search titles →</button></form><div class="result-grid"><template x-for="item in results" :key="item.id"><button class="title-card" @click="choose(item)"><img :src="item.poster_path ? 'https://image.tmdb.org/t/p/w342'+item.poster_path : '/WatchLaroLogoDarj.png'" alt="" loading="lazy"><strong x-text="item.title || item.name"></strong><small x-text="(item.release_date || item.first_air_date || '').slice(0,4) || 'Date unavailable'"></small></button></template></div><p class="note" x-show="!selected && !results.length">Search movies or series to find matching titles. Only download media you are authorized to access.</p></div></section>
<section class="panel" x-show="selected" x-cloak><div class="panel-head"><h2><span class="step">2</span><span x-text="selected?.title || selected?.name"></span></h2><button class="btn small ghost" @click="reset()">Change title</button></div><div class="panel-body"><div class="toolbar border-0 p-0 pb-5"><label class="form-label">Preferred quality<select x-model="quality"><option>720p</option><option>1080p</option><option>2160p</option></select></label><label class="form-label" x-show="type==='tv'">Season<select x-model="season" @change="loadSeason()"><template x-for="s in seasons" :key="s.season_number"><option :value="s.season_number" x-text="s.name"></option></template></select></label><button class="btn primary" x-show="type==='movie'" @click="findTorrent(null)">Find movie sources →</button></div>
<div x-show="type==='tv'"><div class="toolbar border-0 p-0 py-3"><button class="btn small" @click="checked=episodes.filter(e=>aired(e)).map(e=>e.episode_number)">Select aired episodes</button><button class="btn small ghost" @click="checked=[]">Clear selection</button><span class="muted" x-text="checked.length+' selected'"></span></div><template x-for="ep in episodes" :key="ep.id"><div class="episode-row"><input type="checkbox" x-model="checked" :value="ep.episode_number" :disabled="!aired(ep)" :aria-label="'Select episode '+ep.episode_number"><div class="episode-title"><span x-text="'E'+String(ep.episode_number).padStart(2,'0')+' · '+ep.name"></span><small x-text="aired(ep)?ep.air_date:'Not aired yet'"></small></div><button class="btn small" :disabled="!aired(ep)" @click="findTorrent(ep.episode_number)">Choose source →</button></div></template><div class="form-actions"><button class="btn primary" :disabled="!checked.length" @click="bulk(false)">↓ Download selected</button><button class="btn" @click="bulk(true)">Download entire series</button></div><p class="note">Bulk downloads pick the highest-seeded matching episode in your preferred quality. Existing downloads are skipped. Entire-series downloads include aired episodes, excluding specials.</p></div></div></section>
<section class="panel" x-show="selected && (type==='movie' || episode!==null)" x-cloak><div class="panel-head"><h2><span class="step">3</span>Choose a source <span class="muted" x-show="type==='tv'" x-text="tag(season,episode)"></span></h2></div><div class="panel-body"><form class="toolbar border-0 p-0" @submit.prevent="searchTorrents()"><input class="search" x-model="torrentQuery" placeholder="Refine the release search…" aria-label="Torrent search" required><button class="btn">Search sources</button></form><template x-for="(torrent,i) in torrents" :key="i"><button class="torrent-row" @click="download(torrent)" :disabled="!torrent.magnet?.startsWith('magnet:')"><strong x-text="torrent.title"></strong><div class="media-meta"><span x-text="torrent.seeds+' seeds'"></span><span x-text="torrent.size"></span><span x-text="torrent.provider"></span><span class="ml-auto text-blue-300">Queue download ↓</span></div></button></template><p class="note" x-show="!torrents.length">Choose a title or episode above, then search for an available source.</p></div></section></fieldset></div>

<%- include('../layoutEnd') %>
