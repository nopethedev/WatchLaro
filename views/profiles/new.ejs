<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create a profile · WatchLaro</title>
    <link rel="stylesheet" href="/themes/darkTheme/sidebar.css">
    <link rel="stylesheet" href="/themes/darkTheme/theme.css">
    <link rel="stylesheet" href="/styles.css">
    <style>
        .wl-onboard-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(103px, 1fr)); gap: 10px; }
        .wl-pick { border: 2px solid transparent; border-radius: 12px; overflow: hidden; background: #111827; cursor: pointer; padding: 0; text-align: left; }
        .wl-pick img { display: block; width: 100%; aspect-ratio: 2 / 3; object-fit: cover; background: #1e293b; }
        .wl-pick span { display: block; padding: 7px 8px; font-size: 11px; line-height: 1.25; color: #cbd5e1; min-height: 32px; }
        .wl-pick.is-picked { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,.25); }
        .wl-pick.is-picked span { color: #fff; background: #1d4ed8; }
        .wl-avatar-choice { display: flex; gap: 10px; flex-wrap: wrap; }
        .wl-avatar-choice input { position: absolute; opacity: 0; pointer-events: none; }
        .wl-avatar-choice label { display: block; cursor: pointer; border: 3px solid transparent; border-radius: 14px; overflow: hidden; width: 64px; height: 64px; }
        .wl-avatar-choice label:has(input:checked) { border-color: #3b82f6; }
        .wl-avatar-choice img { width: 100%; height: 100%; object-fit: cover; }
    </style>
</head>
<body class="bg-slate-950 text-white min-h-screen">
    <%- include('../header.ejs') %>

    <main class="max-w-6xl mx-auto px-5 py-10">
        <div class="mb-8">
            <a href="/profiles" class="text-sm text-slate-400 hover:text-white">&larr; Profiles</a>
            <h1 class="mt-3 text-4xl font-black tracking-tight">Create your profile</h1>
            <p class="mt-2 text-slate-400">Pick a name, an avatar, and three titles you like. We’ll use those genres to start your recommendations.</p>
        </div>

        <form id="profileForm" class="space-y-8">
            <section class="grid gap-6 md:grid-cols-2">
                <label class="block">
                    <span class="text-sm font-bold text-slate-200">Profile name</span>
                    <input id="profileName" maxlength="24" required placeholder="e.g. Movie night"
                        class="mt-2 w-full rounded-xl border border-slate-700 bg-slate-900 px-4 py-3 text-white placeholder-slate-500 focus:border-blue-500 focus:outline-none">
                </label>
                <div>
                    <span class="text-sm font-bold text-slate-200">Avatar</span>
                    <div class="wl-avatar-choice mt-2">
                        <% avatars.forEach(function (avatar, index) { %>
                        <label title="<%= avatar.label %>">
                            <input type="radio" name="avatar" value="https://api.dicebear.com/10.x/thumbs/svg?seed=<%= encodeURIComponent(avatar.seed) %>" <%= index === 0 ? 'checked' : '' %>>
                            <img src="https://api.dicebear.com/10.x/thumbs/svg?seed=<%= encodeURIComponent(avatar.seed) %>" alt="<%= avatar.label %> avatar">
                        </label>
                        <% }); %>
                    </div>
                </div>
            </section>

            <section>
                <div class="flex flex-wrap items-end justify-between gap-3 mb-3">
                    <div>
                        <h2 class="text-2xl font-extrabold">Pick three titles you enjoy</h2>
                        <p class="text-sm text-slate-400">The genres behind these picks seed this profile’s algorithm.</p>
                    </div>
                    <p id="pickCount" class="rounded-full bg-slate-800 px-4 py-1.5 text-sm font-bold text-slate-300">0 / 3 selected</p>
                </div>
                <div id="titleGrid" class="wl-onboard-grid" aria-busy="true">
                    <p class="text-slate-400 col-span-full">Loading 50 movies and shows…</p>
                </div>
                <p id="onboardError" class="mt-3 hidden rounded-lg border border-red-500/40 bg-red-950/40 p-3 text-sm text-red-300"></p>
            </section>

            <div class="flex justify-end gap-3">
                <a href="/profiles" class="rounded-xl border border-slate-700 px-5 py-3 font-semibold text-slate-300 hover:border-slate-500 hover:text-white">Cancel</a>
                <button id="createButton" type="submit" disabled class="rounded-xl bg-blue-600 px-6 py-3 font-bold text-white transition hover:bg-blue-500 disabled:cursor-not-allowed disabled:opacity-40">Create profile</button>
            </div>
        </form>
    </main>

    <script>
        (function () {
            var selected = [];
            var titles = [];
            var grid = document.getElementById('titleGrid');
            var count = document.getElementById('pickCount');
            var submit = document.getElementById('createButton');
            var name = document.getElementById('profileName');
            var error = document.getElementById('onboardError');

            function update() {
                count.textContent = selected.length + ' / 3 selected';
                submit.disabled = selected.length !== 3 || !name.value.trim();
                submit.textContent = selected.length === 3 ? 'Create profile' : 'Pick ' + (3 - selected.length) + ' more';
            }

            function fail(message) {
                error.textContent = message;
                error.classList.remove('hidden');
            }

            function pick(item, button) {
                var index = selected.findIndex(function (entry) { return entry.type === item.type && entry.id === item.id; });
                if (index >= 0) {
                    selected.splice(index, 1);
                    button.classList.remove('is-picked');
                } else {
                    if (selected.length >= 3) return;
                    selected.push({ type: item.type, id: item.id });
                    button.classList.add('is-picked');
                }
                update();
            }

            function render(items) {
                grid.innerHTML = '';
                grid.setAttribute('aria-busy', 'false');
                items.forEach(function (item) {
                    var button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'wl-pick';
                    button.setAttribute('aria-pressed', 'false');
                    button.setAttribute('aria-label', item.title);
                    var img = document.createElement('img');
                    img.src = 'https://image.tmdb.org/t/p/w342' + item.poster;
                    img.alt = '';
                    img.loading = 'lazy';
                    var label = document.createElement('span');
                    label.textContent = item.title;
                    button.appendChild(img);
                    button.appendChild(label);
                    button.addEventListener('click', function () {
                        var wasPicked = button.classList.contains('is-picked');
                        pick(item, button);
                        button.setAttribute('aria-pressed', String(!wasPicked));
                    });
                    grid.appendChild(button);
                });
            }

            name.addEventListener('input', update);
            document.getElementById('profileForm').addEventListener('submit', async function (event) {
                event.preventDefault();
                if (selected.length !== 3) return;
                submit.disabled = true;
                error.classList.add('hidden');
                var avatar = document.querySelector('input[name="avatar"]:checked');
                try {
                    var response = await fetch('/api/profiles', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ name: name.value.trim(), avatar: avatar ? avatar.value : '', seeds: selected })
                    });
                    var data = await response.json().catch(function () { return {}; });
                    if (!response.ok) throw new Error(data.error || 'Could not create the profile.');
                    location.href = '/';
                } catch (err) {
                    submit.disabled = false;
                    update();
                    fail(err.message);
                }
            });

            fetch('/api/profiles/onboarding')
                .then(function (response) {
                    if (!response.ok) throw new Error('Could not load titles.');
                    return response.json();
                })
                .then(function (data) {
                    titles = data.items || [];
                    if (!titles.length) throw new Error('No titles available.');
                    render(titles.slice(0, 50));
                })
                .catch(function (err) {
                    grid.innerHTML = '<p class="text-slate-400 col-span-full">' + err.message + '</p>';
                    fail(err.message);
                });
        })();
    </script>
</body>
</html>
