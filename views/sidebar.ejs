<head></head>
<body>
    <script>
        var isSidebarOpened = false
    </script>

    <div class="sidebar" id="sidebar">
        <a style="background-color: #2c69df; padding-top: 1px; padding-bottom: 1px;"><h2>EveryoneTube</h2><a>
        <a href="">Videos</a><br>
        <a href="#">Audio</a><br>
        <a href="#">About</a><br>

        <hr>
        <% if (session.username && ) { %>
            <a href="account"></a>
        <% } else if () { %>
            <a href="signup">➕🧑Signup</a>
            <a href="signin">🌐🧑Signin</a>
        <% } %>
        <hr>
        <p xmlns:cc="http://creativecommons.org/ns#" xmlns:dct="http://purl.org/dc/terms/"><span property="dct:title">EveryoneTube</span> by <span property="cc:attributionName">Tabano Studios</span> is licensed under <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/?ref=chooser-v1" target="_blank" rel="license noopener noreferrer" style="display:inline-block;">CC BY-NC-SA 4.0<img style="height:22px!important;margin-left:3px;vertical-align:text-bottom;" src="https://mirrors.creativecommons.org/presskit/icons/cc.svg?ref=chooser-v1" alt=""><img style="height:22px!important;margin-left:3px;vertical-align:text-bottom;" src="https://mirrors.creativecommons.org/presskit/icons/by.svg?ref=chooser-v1" alt=""><img style="height:22px!important;margin-left:3px;vertical-align:text-bottom;" src="https://mirrors.creativecommons.org/presskit/icons/nc.svg?ref=chooser-v1" alt=""><img style="height:22px!important;margin-left:3px;vertical-align:text-bottom;" src="https://mirrors.creativecommons.org/presskit/icons/sa.svg?ref=chooser-v1" alt=""></a></p>
    </div>  

    <button class="toggle-btn" onclick="toggleSidebar()">
        Toggle sidebar
    </button>
    

    <script>function toggleSidebar() {
        var sidebar = document.getElementById('sidebar');
        if (isSidebarOpened){
            sidebar.style.display = 'none';
            isSidebarOpened = false
        }else{
            sidebar.style.display = 'block';
            isSidebarOpened = true
        };
    }</script>
</body>