<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="../themes/darkTheme/sidebar.css">
    <link rel="stylesheet" href="../themes/darkTheme/theme.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Watch Laro - Streaming for everyone</title>

</head>

<body>
    <%- include('header.ejs') %>
        <div class="content">
            <div class="justify-items-center align-center">
                <h1 class="text-l font-bold">Problems when watching? Click <a href="/troubleshoot" class="text-blue-500 underline">here!</a></h1>
            </div>
            <section class="p-10">
                <h1 class="text-4xl font-black pb-2">🍿 Now Playing</h1>
                <div class="flex flex-col align-center overflow-y-hidden">
                    <div class="flex overflow-x-auto gap-2 p-1 overflow-y-hidden" id="now_playing">

                    </div>
                </div>
            </section>

            <section class="p-10">
                <h1 class="text-4xl font-black pb-2">🤩 Popular Right Now</h1>
                <div class="flex flex-col align-center">
                    <div class="flex overflow-x-auto gap-2 p-1 overflow-y-hidden" id="popular">

                    </div>
                </div>

            </section>

            <section class="p-10">
                <h1 class="text-4xl font-black pb-2">🔥 Top Rated</h1>
                <div class="flex flex-col align-center">
                    <div class="flex overflow-x-auto gap-2 p-1 overflow-y-hidden" id="top_rated">

                    </div>
                </div>

            </section>

            <script>

                async function getFeedData() {
                    const response = await fetch("/api/movies/feed")

                    if (response.ok) {
                        const data = await response.json()

                        data.now_playing.results.forEach(element => {
                            putPoster("now_playing", element)
                        });
                        data.popular.results.forEach(element => {
                            putPoster("popular", element)
                        });
                        data.top_rated.results.forEach(element => {
                            putPoster("top_rated", element)
                        })
                    } else {
                        // document.getElementById('debugthing').innerText = 'fetch err'
                    }
                }
                async function putPoster(category, element) {
                    const div = document.createElement("div")
                    div.classList.add("w-[200px]", "flex-shrink-0")
                    const btn = document.createElement("button")
                    btn.classList.add("relative","z-10", "rounded-md", "flex", "flex-col", "align-center", "hover:scale-[105%]", "transition-all", "duration-150", "group")
                    btn.onclick = function () {
                        window.location.href = "/movies/info?q=" + element.id
                    }
                    const img = document.createElement("img")
                    img.classList.add("rounded-md", "blur-none", "hover:blur-[4px]", "z-20")
                    const text = document.createElement("h2")
                    text.classList.add("absolute", "bottom-4", "text-lg", "font-bold", "opacity-0", "translate-y-full", "group-hover:opacity-100", "group-hover:translate-y-0", "ease-in-out", "duration-200", "text-center", "w-full", "left-0", "z-30")
                    text.innerText = element.title
                    //img.classList.add()
                    img.src = "https://image.tmdb.org/t/p/w500" + element.poster_path
                    document.getElementById(category).appendChild(div)
                    div.appendChild(btn)
                    btn.appendChild(img)
                    btn.appendChild(text)
                }
                try {
                    getFeedData()
                } catch (err) {
                    throw new Error(err)
                }

            </script>
            <script>
                (async () => {
                    const hasBeenNotified = await cookieStore.get("notifiedUser");

                    if (false) {
                        Swal.fire({
                            title: "Welcome! Notice for travelers.",
                            theme: "auto",
                            html: "We do not host any of the movie files, we are a search engine. We search the web and find a playable link for you to watch. If you would like to take down a movie, please contact the owners of the media. Made with love by Nope."
                        })
                        cookieStore.set("notifiedUser", true, { expires: Date.now() + 60 * 60 * 24 })
                    }
                })()
            </script>


        </div>

</body>

</html>