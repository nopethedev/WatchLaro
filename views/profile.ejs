<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="/themes/darkTheme/sidebar.css">
    <link rel="stylesheet" href="/themes/darkTheme/theme.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laro - Loading...</title>

</head>

<body>
    <%- include('header.ejs') %>
        <script>
            function profile() {

                return {
                    user: {},
                    async loadProfile() {
                        console.log("loading profile")
                        const response = await fetch("/api/profile/info/" + window.location.pathname.split("/")[2]);
                        if (response.ok) {
                            console.log("ok")
                            this.user = await response.json()
                        } else {
                            console.log("not ok")
                        }
                    }
                }
            }
        </script>
        <div class="content">
            <div class="p-4 w-full">
                <div x-data="profile()" x-init="loadProfile()">
                    <div class="lg:show flex items-center">
                        <img :src="user.profilePicture" class="rounded-full max-w-32 hover:scale-105 transition-all duration-150" alt="Generated by DiceBear :3">
                        <h1 class="text-4xl font-black ml-4" x-text="user.username">username</h1>
                    </div>
                    <div class="bg-gray-900 lg:w-4xl md:w-1xl w-lg mt-4 ">
                        <p class="text-md w-full" x-text="user.bio"></p>
                    </div>
                </div>
            </div>
        </div>



</body>

</html>