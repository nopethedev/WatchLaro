<!DOCTYPE html>
<html lang="en" class="tv-html">

<%- include('partials/head', { pageTitle: "Manage profiles" }) %>

<body class="tv-body" data-tv-page="manage" data-tv-back="/tvui/">
    <main class="tv-profiles">
        <p class="tv-onboard-kicker">ACCOUNT PROFILES</p>
        <h1 class="tv-profiles-title">Manage profiles</h1>
        <p class="tv-profiles-hint">Each profile has its own history and recommendations. You can keep up to five.</p>

        <div class="tv-manage-list" data-tv-row>
            <% profiles.forEach(function (profile) { %>
            <div class="tv-manage-card">
                <span class="tv-profile-tile"><img src="<%= profile.avatar %>" alt=""></span>
                <strong><%= profile.name %></strong>
                <span class="tv-manage-actions">
                    <a class="tv-exit" href="/tvui/profiles/<%= profile.id %>/edit" data-tv-item>Edit</a>
                    <button type="button" class="tv-exit" data-tv-item onclick="removeProfile(<%= profile.id %>, <%- JSON.stringify(profile.name) %>)">Delete</button>
                </span>
            </div>
            <% }); %>
        </div>

        <div class="tv-profiles-actions" data-tv-row>
            <% if (profiles.length < 5) { %><a class="tv-btn tv-btn-primary" href="/tvui/profiles/new" data-tv-item>+ Add profile</a><% } %>
            <a class="tv-btn tv-btn-ghost" href="/tvui/" data-tv-item>Done</a>
        </div>
    </main>
    <script src="/tvui.js"></script>
    <script>
        async function removeProfile(id, name) {
            if (!confirm('Delete the profile "' + name + '" and its watch history?')) return;
            var response = await fetch('/api/profiles/' + id, { method: 'DELETE' });
            var data = await response.json().catch(function () { return {}; });
            if (!response.ok) return alert(data.error || 'Could not delete profile.');
            location.reload();
        }
    </script>
</body>
</html>
