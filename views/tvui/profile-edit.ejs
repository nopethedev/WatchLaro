<!DOCTYPE html>
<html lang="en" class="tv-html">

<%- include('partials/head', { pageTitle: "Edit profile" }) %>

<body class="tv-body" data-tv-page="profile-edit" data-tv-nav="spatial" data-tv-back="/tvui/manage">
    <main class="tv-onboard tv-onboard-compact">
        <div class="tv-onboard-head">
            <a class="tv-exit" href="/tvui/manage" data-tv-item>← Back to manage</a>
            <p class="tv-onboard-kicker">CUSTOMIZE PROFILE</p>
            <h1><%= profile.name %></h1>
            <p>Change the name or avatar. This won’t reset the profile’s watch history.</p>
        </div>

        <div class="tv-onboard-name-row">
            <label class="tv-onboard-name">
                <span>Profile name</span>
                <input id="profileName" maxlength="24" value="<%= profile.name %>" data-tv-item data-tv-autofocus>
            </label>
            <div class="tv-onboard-avatars" data-tv-row aria-label="Avatar">
                <% avatars.forEach(function (avatar) { var url = 'https://api.dicebear.com/10.x/thumbs/svg?seed=' + encodeURIComponent(avatar.seed); %>
                <button type="button" class="tv-onboard-avatar <%= profile.avatar === url ? 'is-selected' : '' %>" data-avatar="<%= url %>" data-tv-item aria-label="<%= avatar.label %> avatar">
                    <img src="<%= url %>" alt="">
                </button>
                <% }); %>
            </div>
        </div>

        <p id="editError" class="tv-onboard-error" hidden></p>
        <div class="tv-onboard-actions" data-tv-row>
            <button id="saveButton" type="button" class="tv-btn tv-btn-primary" data-tv-item>Save changes</button>
            <a class="tv-btn tv-btn-ghost" href="/tvui/manage" data-tv-item>Cancel</a>
            <button type="button" class="tv-btn tv-btn-ghost" data-tv-item onclick="removeProfile(<%= profile.id %>, <%- JSON.stringify(profile.name) %>)">Delete profile</button>
        </div>
    </main>
    <script src="/tvui.js"></script>
    <script>
        (function () {
            var avatar = document.querySelector('.tv-onboard-avatar.is-selected')?.getAttribute('data-avatar') || '';
            var error = document.getElementById('editError');
            document.querySelectorAll('.tv-onboard-avatar').forEach(function (item) {
                item.addEventListener('click', function () {
                    document.querySelectorAll('.tv-onboard-avatar').forEach(function (other) { other.classList.remove('is-selected'); });
                    item.classList.add('is-selected');
                    avatar = item.getAttribute('data-avatar');
                });
            });
            document.getElementById('saveButton').addEventListener('click', async function () {
                error.hidden = true;
                var response = await fetch('/api/profiles/<%= profile.id %>', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: document.getElementById('profileName').value.trim(), avatar: avatar })
                });
                var data = await response.json().catch(function () { return {}; });
                if (!response.ok) {
                    error.textContent = data.error || 'Could not save profile.';
                    error.hidden = false;
                    return;
                }
                location.href = '/tvui/manage';
            });
        })();

        async function removeProfile(id, name) {
            if (!confirm('Delete the profile "' + name + '" and its watch history?')) return;
            var response = await fetch('/api/profiles/' + id, { method: 'DELETE' });
            var data = await response.json().catch(function () { return {}; });
            if (!response.ok) return alert(data.error || 'Could not delete profile.');
            location.href = '/tvui/';
        }
    </script>
</body>
</html>
